# Frontend
# Passed to Flutter with --dart-define=API_BASE_URL=...
API_BASE_URL=http://localhost:8000/api

# Backend
API_TITLE=MediLens AI Backend
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# DBMS (Docker Compose uses PostgreSQL by default)
POSTGRES_DB=medilens
POSTGRES_USER=medilens
POSTGRES_PASSWORD=medilens
DATABASE_URL=postgresql+psycopg://medilens:medilens@db:5432/medilens

# Optional future AI integration
AI_PROVIDER=mock
OPENAI_API_KEY=
